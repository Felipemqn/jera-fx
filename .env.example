# ─────────────────────────────────────────────────────────
# JERA FX — Environment variables template
# Copy to .env (NOT committed) and fill in real values.
# ─────────────────────────────────────────────────────────

# App
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_DB=jera_fx
POSTGRES_USER=jera_fx_app
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
# Full URL used by the API container (points to the compose "db" service)
DATABASE_URL=postgresql+psycopg://jera_fx_app:CHANGE_ME_BEFORE_DEPLOY@db:5432/jera_fx

# Paths (relative to WORKDIR inside the container)
SERIES_CATALOG_PATH=config/series_catalog.yml
REER_WORKBOOK_PATH=data/raw/reer/REER_database_ver11Mar2026.xlsx
CDS_BRAZIL_5Y_FILE_PATH=data/raw/cds/BRGV5YUSAC=R_2026-04-07.csv

# CORS — comma-separated list of allowed frontend origins
# In production, set to the actual hostnames of client-web and investment-web
CORS_ALLOWED_ORIGINS=https://client.jera.capital,https://investment.jera.capital

# Scheduler
# How often to run the daily refresh loop (seconds). Default 86400 = 24h.
SCHEDULER_INTERVAL_SECONDS=86400

# Backup
# How long to keep daily backups (days). Older backups are auto-deleted.
BACKUP_RETENTION_DAYS=14
